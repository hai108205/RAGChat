# =============================================================
# RAGChat — Environment template
# Copy to `.env` and fill in your secrets:
#     cp .env.example .env
# =============================================================

# ---------- LLM Provider ----------
# openai | claude
LLM_PROVIDER=openai

# Required: set one of these, matching LLM_PROVIDER.
# OpenAI key (embedding + LLM). Required for `openai` provider.
OPENAI_API_KEY=
# Anthropic Claude key. Required for `claude` provider.
ANTHROPIC_API_KEY=

# Model names (override defaults on the backend).
MODEL=gpt-4o
# Embedding model (used for documents + queries).
EMBEDDING_MODEL=text-embedding-3-small

# ---------- Storage ----------
# Store uploads in MinIO instead of the local filesystem.
USE_MINIO=false
# Use ARQ background worker for async document indexing.
USE_ASYNC_INDEXING=false

# ---------- Auth ----------
# Bearer token required on /api/* endpoints. Empty = open (dev only).
API_KEY=

# ---------- Rocket.Chat ----------
# Webhook URL the backend calls to notify the app of job completion.
APP_CALLBACK_URL=

# ---------- Monitoring ----------
# Grafana admin credentials (docker-compose; default admin/admin).
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ---------- Advanced tuning (optional) ----------
# All values below have sensible defaults in backend/src/config.py;
# uncomment overrides the backend when you need to tune behaviour.
# Local backend and the docker-compose `backend` service both read these.
#
# DATABASE_URL=postgresql://ragchat:ragchat@localhost:5432/ragchat
# REDIS_URL=redis://localhost:6379/0
# TEMPERATURE=0.7
# MAX_TOKENS=2048
# TOP_K=5
# SIMILARITY_THRESHOLD=0.3
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# CHUNKING_STRATEGY=semantic
# PROTECT_TABLES=true
# USE_HYBRID_SEARCH=false
# HYBRID_WEIGHT=0.5
# USE_QUERY_EXPANSION=false
# QUERY_EXPANSION_COUNT=3
# ENFORCE_ROOM_ISOLATION=true
# EMBEDDING_DIMENSION=1536
# CHAT_HISTORY_LENGTH=2
# SYNTHESIS_STRATEGY=tree-summarization
# HOST=0.0.0.0
# PORT=8000
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_SECURE=false