PORT="8000"
CORS_ORIGIN="http://localhost:5173"
CORS_METHODS="GET,POST,PUT,DELETE"

DATABASE_URL="postgresql://testuser:testpassword@localhost:5432/docchat"

REFRESH_TOKEN_SECRET="your-refresh-token-secret"
REFRESH_TOKEN_EXPIRY="10d"
ACCESS_TOKEN_SECRET="your-access-token-secret"
ACCESS_TOKEN_EXPIRY="1d"

NODE_ENV="development"

RESEND_API_KEY=""

# Exactly 32 random bytes encoded as canonical base64 (generate with: openssl rand -base64 32)
CIPHER_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
ENCRYPTION_ALGORITHM="aes-256-gcm"

OPENROUTER_LLM_API_KEY="your-openrouter-llm-key"
OPENROUTER_EMBEDDING_API_KEY="your-openrouter-embedding-key"

QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# Optional runtime controls
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
DEFAULT_LLM_MODEL="openai/gpt-4o-mini"
EMBEDDING_MODEL="openai/text-embedding-3-small"
ENABLE_WEB_ROUTES="false"
JSON_BODY_LIMIT="20mb"
LOG_LEVEL="info"
METRICS_TOKEN=""
DAILY_TOKEN_BUDGET=""
ADMIN_USERNAME=""
ALLOW_ROCKETCHAT_GLOBAL_MODE="false"
ROCKETCHAT_WORKER_CONCURRENCY=5
TREEINDEX_API_KEY=""
MODEL=""

REDIS_HOST="localhost"
REDIS_PORT=6379

# Rocket.Chat Integration Security & Callback Configuration
ROCKETCHAT_INTEGRATION_TOKEN="your-shared-rocketchat-integration-token"
ROCKETCHAT_CALLBACK_BASE_URL="http://localhost:3001"
ROCKETCHAT_CALLBACK_ALLOWED_ORIGINS="http://localhost:3001,http://rocketchat:3000"
ALLOW_UNAUTHENTICATED_ROCKETCHAT_DEV="false"

# Crawler policy
CRAWL_USER_AGENT="DocChatBot/1.0"
CRAWL_RESPECT_ROBOTS_TXT="true"
CRAWL_DELAY_MS=1000
CRAWL_MAX_CONCURRENCY_PER_DOMAIN=3
CRAWL_ROBOTS_TIMEOUT_MS=5000
CRAWL_ROBOTS_CACHE_TTL_MS=600000
CRAWL_ALLOW_ON_ROBOTS_ERROR="false"
QDRANT_CLEANUP_MIN_AGE_DAYS=7

# RAG v1 rollout (all false by default for safe migration)
RAG_V1_ENABLED="false"
RAG_V1_DUAL_WRITE_ENABLED="false"
RAG_V1_DUAL_READ_ENABLED="false"
RAG_ALLOW_LEGACY_AVAILABILITY_FALLBACK="false"
RAG_INDEX_VERSION="v1"
RAG_CHUNK_SIZE_TOKENS=640
RAG_CHUNK_OVERLAP_TOKENS=80
RAG_RETRIEVAL_CANDIDATE_LIMIT=24
RAG_CONTEXT_TOKEN_BUDGET=6000

MEM0_API_KEY=""
MEM0_TELEMETRY=false
