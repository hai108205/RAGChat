PORT="8000"
CORS_ORIGIN="http://localhost:5173"
CORS_METHODS="GET,POST,PUT,DELETE"

DATABASE_URL="postgresql://testuser:testpassword@localhost:5432/docchat"

REFRESH_TOKEN_SECRET="your-refresh-token-secret"
REFRESH_TOKEN_EXPIRY="10d"
ACCESS_TOKEN_SECRET="your-access-token-secret"
ACCESS_TOKEN_EXPIRY="1d"

NODE_ENV="development"

RESEND_API_KEY=""

CIPHER_KEY="your-32-byte-hex-cipher-key"
ENCRYPTION_ALGORITHM="aes-256-gcm"

OPENROUTER_LLM_API_KEY="your-openrouter-llm-key"
OPENROUTER_EMBEDDING_API_KEY="your-openrouter-embedding-key"

QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

REDIS_HOST="localhost"
REDIS_PORT=6379

ROCKETCHAT_INTEGRATION_TOKEN="your-shared-rocketchat-integration-token"

# Ingestion pipeline tuning (vector chat creation)
CRAWL_MAX_PAGES_PER_JOB=300
CRAWL_SCRAPE_CONCURRENCY=10
CRAWL_VECTORLESS_BATCH_SIZE=10
EMBEDDING_BATCH_SIZE=500
QDRANT_BATCH_SIZE=500
CHAT_WORKER_CONCURRENCY=1

MEM0_API_KEY=""
MEM0_TELEMETRY=false
