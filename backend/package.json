{
    "name": "backend",
    "version": "1.0.0",
    "description": "",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "dev": "tsx watch index.ts",
        "start": "node dist/index.js",
        "worker": "tsx chatWorker.ts",
        "worker:integration": "tsx workers/rocketchatIntegrationWorker.ts",
        "rag:backfill": "tsx scripts/backfillRagV1.ts",
        "rag:evaluate-quality": "tsx scripts/evaluateRagQuality.ts",
        "test": "vitest",
        "test:ci": "vitest run",
        "test:contract": "vitest run tests/integration/rocketchat.integration.test.ts",
        "generate:contract": "node ../scripts/generate-contract.mjs",
        "check:contract": "node ../scripts/check-integration-contract.mjs",
        "db:test:up": "docker compose -f docker-compose.test.yml up -d",
        "db:test:down": "docker compose -f docker-compose.test.yml down -v",
        "pretest": "pnpm run db:test:up && pnpm prisma migrate deploy"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.30.3",
    "type": "module",
    "dependencies": {
        "@langchain/core": "^1.1.36",
        "@langchain/openai": "1.1.3",
        "@langchain/textsplitters": "^1.0.1",
        "@prisma/adapter-pg": "^7.5.0",
        "@prisma/client": "^7.5.0",
        "@prisma/client-runtime-utils": "^7.5.0",
        "@qdrant/js-client-rest": "^1.17.0",
        "@types/pdf-parse": "^1.1.5",
        "bcrypt": "^6.0.0",
        "bottleneck": "^2.19.5",
        "bullmq": "^5.71.1",
        "cheerio": "^1.2.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "ioredis": "^5.10.1",
        "jsonwebtoken": "^9.0.3",
        "jszip": "^3.10.1",
        "mammoth": "^1.12.2",
        "mem0ai": "^2.4.4",
        "openai": "^6.33.0",
        "pdf-parse": "^2.4.5",
        "pdfkit": "^0.19.1",
        "pg": "^8.20.0",
        "pino": "^9.6.0",
        "pino-pretty": "^13.1.3",
        "prisma": "^7.5.0",
        "prom-client": "^15.1.3",
        "resend": "^6.9.4",
        "robots-parser": "^3.0.1",
        "treeindex": "^1.0.0",
        "uuid": "^13.0.0",
        "xlsx": "^0.18.5",
        "zod": "^4.4.3"
    },
    "overrides": {
        "mem0ai": {
            "@qdrant/js-client-rest": "$@qdrant/js-client-rest",
            "pg": "$pg"
        }
    },
    "devDependencies": {
        "@jest/globals": "^30.4.1",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.4.0",
        "@types/pdfkit": "^0.17.6",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "@types/uuid": "^11.0.0",
        "supertest": "^7.2.2",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2",
        "vitest": "^4.1.8"
    }
}
